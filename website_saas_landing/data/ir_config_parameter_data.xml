<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data noupdate="1">

    <!-- Default recipient of the internal "new enquiry" notification. -->
    <record id="param_enquiry_recipient_email" model="ir.config_parameter">
        <field name="key">website_saas_landing.enquiry_recipient_email</field>
        <field name="value">notifications@myodoo.sh</field>
    </record>

    <!-- Default From address. It matches the default outgoing mail server
         (from_filter), so Odoo sends enquiry emails through that server. -->
    <record id="param_enquiry_from_email" model="ir.config_parameter">
        <field name="key">website_saas_landing.enquiry_from_email</field>
        <field name="value">notifications@myodoo.sh</field>
    </record>

</data>
</odoo>
