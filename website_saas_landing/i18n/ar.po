#: model:mail.template,body_html:website_saas_landing.mail_template_enquiry_customer
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#1c1720\">\n"
"  <p style=\"margin:0 0 12px\">Hi <t t-out=\"object.full_name or ''\"/>,</p>\n"
"  <p style=\"margin:0 0 12px\">\n"
"    Thank you for contacting MyOdoo.sh. We have received your enquiry and our team\n"
"    will review your requirements shortly.\n"
"  </p>\n"
"  <p style=\"margin:0 0 18px\">\n"
"    Reference: <b><t t-out=\"object.name or ''\"/></b>\n"
"  </p>\n"
"  <p style=\"margin:0 0 18px;color:#6b6470\">\n"
"    If you need to add anything to your request, simply reply to this email.\n"
"  </p>\n"
"  <p style=\"margin:0;color:#6b6470\">— The MyOdoo.sh team</p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#1c1720\"><p style=\"margin:0 0 12px\">مرحباً <t t-out=\"object.full_name or ''\"></t>..</p><p style=\"margin:0 0 12px\">شكراً على إتصالك بـ (مايدو) لقد تلقينا استفسارك و فريقنا\n"
"ستراجع احتياجاتك قريباً\n"
" </p><p style=\"margin:0 0 18px\">المرجع: <b><t t-out=\"object.name or ''\"></t></b></p><p style=\"margin:0 0 18px;color:#6b6470\">إذا كنت بحاجة إلى إضافة أي شيء إلى طلبك، مجرد الرد على هذا البريد الإلكتروني.\n"
" </p><p style=\"margin:0;color:#6b6470\">- فريق ميدو</p></div>"

#. module: website_saas_landing
#: model:mail.template,body_html:website_saas_landing.mail_template_enquiry_internal
msgid ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#1c1720\">\n"
"  <p style=\"margin:0 0 4px;font-size:16px;font-weight:bold\">New enquiry received from MyOdoo.sh</p>\n"
"  <p style=\"margin:0 0 18px;color:#6b6470\">A visitor submitted the website enquiry form.</p>\n"
"\n"
"  <table cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;width:100%;max-width:620px\">\n"
"    <tbody>\n"
"      <tr>\n"
"        <td style=\"padding:7px 0;width:160px;color:#6b6470\">Enquiry ID</td>\n"
"        <td style=\"padding:7px 0;font-weight:bold\"><t t-out=\"object.name or ''\"/></td>\n"
"      </tr>\n"
"      <tr>\n"
"        <td style=\"padding:7px 0;color:#6b6470\">Name</td>\n"
"        <td style=\"padding:7px 0\"><t t-out=\"object.full_name or ''\"/></td>\n"
"      </tr>\n"
"      <tr>\n"
"        <td style=\"padding:7px 0;color:#6b6470\">Company</td>\n"
"        <td style=\"padding:7px 0\"><t t-out=\"object.company_name or ''\"/></td>\n"
"      </tr>\n"
"      <tr>\n"
"        <td style=\"padding:7px 0;color:#6b6470\">Email</td>\n"
"        <td style=\"padding:7px 0\"><t t-out=\"object.email or ''\"/></td>\n"
"      </tr>\n"
"      <tr>\n"
"        <td style=\"padding:7px 0;color:#6b6470\">Phone</td>\n"
"        <td style=\"padding:7px 0\"><t t-out=\"object.phone or '—'\"/></td>\n"
"      </tr>\n"
"      <tr>\n"
"        <td style=\"padding:7px 0;color:#6b6470\">Country</td>\n"
"        <td style=\"padding:7px 0\"><t t-out=\"object.country or '—'\"/></td>\n"
"      </tr>\n"
"      <tr>\n"
"        <td style=\"padding:7px 0;color:#6b6470\">Interested In</td>\n"
"        <td style=\"padding:7px 0\"><t t-out=\"dict(object._fields['interested_in'].selection).get(object.interested_in, '')\"/></td>\n"
"      </tr>\n"
"      <tr>\n"
"        <td style=\"padding:7px 0;color:#6b6470\">Odoo Version</td>\n"
"        <td style=\"padding:7px 0\"><t t-out=\"object.odoo_version or '—'\"/></td>\n"
"      </tr>\n"
"      <tr>\n"
"        <td style=\"padding:7px 0;color:#6b6470\">Estimated Users</td>\n"
"        <td style=\"padding:7px 0\"><t t-out=\"object.estimated_users or '—'\"/></td>\n"
"      </tr>\n"
"      <tr>\n"
"        <td style=\"padding:7px 0;color:#6b6470;vertical-align:top\">Submitted</td>\n"
"        <td style=\"padding:7px 0\"><t t-out=\"object.submission_date or ''\"/></td>\n"
"      </tr>\n"
"    </tbody>\n"
"  </table>\n"
"\n"
"  <p style=\"margin:20px 0 6px;color:#6b6470\">Message:</p>\n"
"  <div style=\"padding:14px 16px;background:#f7f3f8;border-radius:10px;white-space:pre-wrap\">\n"
"    <t t-out=\"object.message or ''\"/>\n"
"  </div>\n"
"\n"
"  <p style=\"margin:24px 0 0\">\n"
"    <a t-att-href=\"'%s/odoo/action-%s/%s' % (object.get_base_url(), object.env.ref('website_saas_landing.action_website_saas_enquiry').id, object.id)\" style=\"display:inline-block;padding:12px 22px;background:#714b67;color:#ffffff;text-decoration:none;border-radius:10px;font-weight:bold\">\n"
"      Open Enquiry in Odoo\n"
"    </a>\n"
"  </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#1c1720\"><p style=\"margin:0 0 4px;font-size:16px;font-weight:bold\">وردت استفسارات جديدة من ميودو</p><p style=\"margin:0 0 18px;color:#6b6470\">وقدم زائر استمارة التحقيق على الموقع الشبكي.</p><table cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;width:100%;max-width:620px\"><tbody><tr><td style=\"padding:7px 0;width:160px;color:#6b6470\">هوية التحقيق</td><td style=\"padding:7px 0;font-weight:bold\"><t t-out=\"object.name or ''\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">الاسم</td><td style=\"padding:7px 0\"><t t-out=\"object.full_name or ''\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">Company</td><td style=\"padding:7px 0\"><t t-out=\"object.company_name or ''\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">Email</td><td style=\"padding:7px 0\"><t t-out=\"object.email or ''\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">Phone</td><td style=\"padding:7px 0\"><t t-out=\"object.phone or '—'\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">البلد</td><td style=\"padding:7px 0\"><t t-out=\"object.country or '—'\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">الاهتمام</td><td style=\"padding:7px 0\"><t t-out=\"dict(object._fields['interested_in'].selection).get(object.interested_in, '')\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">Odoo Version</td><td style=\"padding:7px 0\"><t t-out=\"object.odoo_version or '—'\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">المستعملون المقدرون</td><td style=\"padding:7px 0\"><t t-out=\"object.estimated_users or '—'\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470;vertical-align:top\">مقدمة</td><td style=\"padding:7px 0\"><t t-out=\"object.submission_date or ''\"></t></td></tr></tbody></table><p style=\"margin:20px 0 6px;color:#6b6470\">الرسالة:</p><div style=\"padding:14px 16px;background:#f7f3f8;border-radius:10px;white-space:pre-wrap\"><t t-out=\"object.message or ''\"></t></div><p style=\"margin:24px 0 0\"><a style=\"display:inline-block;padding:12px 22px;background:#714b67;color:#ffffff;text-decoration:none;border-radius:10px;font-weight:bold\" t-att-href=\"'%s/odoo/action-%s/%s' % (object.get_base_url(), object.env.ref('website_saas_landing.action_website_saas_enquiry').id, object.id)\">التحقيق المفتوح في أودو\n"
" </a></p></div>"

