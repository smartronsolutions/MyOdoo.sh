"      Open Enquiry in Odoo\n"
"    </a>\n"
"  </p>\n"
"</div>\n"
"        "
msgstr ""
"<div style=\"margin:0;padding:0;font-family:Arial,Helvetica,sans-serif;font-size:14px;color:#1c1720\"><p style=\"margin:0 0 4px;font-size:16px;font-weight:bold\">Một cuộc điều tra mới nhận được từ MyOdoo.sh.</p><p style=\"margin:0 0 18px;color:#6b6470\">Một vị khách đã gửi đơn hỏi thăm trang web.</p><table cellpadding=\"0\" cellspacing=\"0\" style=\"border-collapse:collapse;width:100%;max-width:620px\"><tbody><tr><td style=\"padding:7px 0;width:160px;color:#6b6470\">Chứng minh thư</td><td style=\"padding:7px 0;font-weight:bold\"><t t-out=\"object.name or ''\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">Tên</td><td style=\"padding:7px 0\"><t t-out=\"object.full_name or ''\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">Công ti</td><td style=\"padding:7px 0\"><t t-out=\"object.company_name or ''\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">Email</td><td style=\"padding:7px 0\"><t t-out=\"object.email or ''\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">Điện thoại</td><td style=\"padding:7px 0\"><t t-out=\"object.phone or '—'\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">Nước</td><td style=\"padding:7px 0\"><t t-out=\"object.country or '—'\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">Quan tâm</td><td style=\"padding:7px 0\"><t t-out=\"dict(object._fields['interested_in'].selection).get(object.interested_in, '')\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">Phiên bản Odoo</td><td style=\"padding:7px 0\"><t t-out=\"object.odoo_version or '—'\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470\">Người dùng đã ước tính</td><td style=\"padding:7px 0\"><t t-out=\"object.estimated_users or '—'\"></t></td></tr><tr><td style=\"padding:7px 0;color:#6b6470;vertical-align:top\">Đã gửi</td><td style=\"padding:7px 0\"><t t-out=\"object.submission_date or ''\"></t></td></tr></tbody></table><p style=\"margin:20px 0 6px;color:#6b6470\">Thông điệp:</p><div style=\"padding:14px 16px;background:#f7f3f8;border-radius:10px;white-space:pre-wrap\"><t t-out=\"object.message or ''\"></t></div><p style=\"margin:24px 0 0\"><a style=\"display:inline-block;padding:12px 22px;background:#714b67;color:#ffffff;text-decoration:none;border-radius:10px;font-weight:bold\" t-att-href=\"'%s/odoo/action-%s/%s' % (object.get_base_url(), object.env.ref('website_saas_landing.action_website_saas_enquiry').id, object.id)\">Mở cuộc điều tra ở Odoo\n"
" </a></p></div>"

