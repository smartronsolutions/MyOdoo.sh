<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>

<record id="saas_landing_page" model="website.page">
  <field name="name">Home (My Odoo SH)</field>
  <field name="url">/saas</field>
  <field name="type">qweb</field>
  <field name="is_published">True</field>
  <field name="website_indexed">True</field>
  <field name="arch" type="xml">
<t t-name="website_saas_landing.saas_landing_page">
<t t-call="website.layout">
<t t-set="additional_title">My Odoo SH — Home</t>
<t t-set="no_footer" t-value="true"/>
<div id="wrap">
<div class="mo_site mo_home_page mh">
<div class="top-glow"></div>

<main>
    <!-- ============================================================
         1. HERO — full-width product experience
         ============================================================ -->
    <section class="mh-hero">
      <div class="mh-hero-bg" aria-hidden="true"></div>
      <div class="container mh-hero-inner">
        <span class="mh-pill" data-reveal="1"><i></i><span data-i18n="mh_pill">Odoo Cloud Platform</span></span>
        <h1 data-reveal="1" data-i18n-html="hero_title">Your Odoo cloud.<br/><span class="mh-grad">Live in minutes.</span></h1>
        <p class="mh-sub" data-reveal="1" data-i18n="hero_text">Host, deploy and manage Odoo with staging environments, automated backups and monitoring—all from one platform.</p>
        <div class="mh-cta-row" data-reveal="1">
          <button class="mh-btn mh-btn-primary" onclick="location.href='/pricing'" data-i18n="hero_btn1">Start Your Project</button>
          <button class="mh-btn mh-btn-ghost" onclick="location.href='/contact-us'" data-i18n="hero_btn2">Book a Demo</button>
        </div>

        <div class="mh-dash-wrap" data-reveal="1">
          <span class="mh-float mh-f1" aria-hidden="true"><i class="mh-pulse"></i>Production · Running</span>
          <span class="mh-float mh-f2" aria-hidden="true">☁ Backup completed</span>
          <span class="mh-float mh-f3" aria-hidden="true">PostgreSQL</span>
          <span class="mh-float mh-f4" aria-hidden="true">🔒 SSL Active</span>
          <span class="mh-float mh-f5" aria-hidden="true">✓ Deployment successful</span>

          <div class="mh-dash" role="img" aria-label="Platform preview: My Company project with production, staging and development environments, deployment status, backup status, resource usage and SSL.">
            <div class="mh-dash-bar">
              <span class="mh-dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="mh-url">app.myodoo.sh/my-company</span>
              <span class="mh-preview-tag" data-i18n="mh_preview">Platform preview</span>
            </div>
            <div class="mh-dash-body">
              <div class="mh-dash-side">
                <span class="is-active">Overview</span>
                <span>Deployments</span>
                <span>Backups</span>
                <span>Logs</span>
                <span>Monitoring</span>
              </div>
              <div class="mh-dash-main">
                <div class="mh-dash-top">
                  <b>My Company</b>
                  <div class="mh-env-tabs">
                    <span data-i18n="pp_dev">Development</span>
                    <span data-i18n="pp_staging">Staging</span>
                    <span class="is-active" data-i18n="pp_prod">Production</span>
                  </div>
                </div>
                <div class="mh-dash-stats">
                  <div class="mh-stat"><small data-i18n="pp_status">Status</small><b class="ok"><i></i><span data-i18n="pp_running">Running</span></b></div>
                  <div class="mh-stat"><small data-i18n="pp_deploy">Latest deployment</small><b>main · successful</b></div>
                  <div class="mh-stat"><small data-i18n="pp_backup">Backup</small><b data-i18n="pp_backup_val">Scheduled daily</b></div>
                </div>
                <div class="mh-dash-cols">
                  <div class="mh-chart">
                    <small data-i18n="pp_res">Resource usage</small>
                    <svg class="mh-spark" viewBox="0 0 300 80" preserveAspectRatio="none" aria-hidden="true">
                      <polygon class="mh-spark-fill" points="0,58 30,50 60,54 90,38 120,44 150,26 180,32 210,18 240,24 270,12 300,16 300,80 0,80"/>
                      <polyline class="mh-spark-line" points="0,58 30,50 60,54 90,38 120,44 150,26 180,32 210,18 240,24 270,12 300,16"/>
                    </svg>
                  </div>
                  <div class="mh-dash-list">
                    <div><i class="ok"></i>PostgreSQL connected</div>
                    <div><i class="ok"></i>SSL active</div>
                    <div><i class="ok"></i>Workers healthy</div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================
         2. TRUST / PLATFORM BAR
         ============================================================ -->
    <div class="mh-trust"><div class="container mh-trust-inner">
      <span class="mh-trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="7" cy="6" r="2.4"/><circle cx="7" cy="18" r="2.4"/><circle cx="17" cy="10" r="2.4"/><path d="M7 8.4v7.2"/><path d="M17 12.4c0 3-2.4 5.6-5.6 5.6H9.4"/></svg><span data-i18n="trust1">Git Deployment</span></span>
      <i class="mh-sep" aria-hidden="true"></i>
      <span class="mh-trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8l-9-4-9 4v8l9 4 9-4z"/><path d="M3.3 7.5 12 12l8.7-4.5"/><path d="M12 12v9"/></svg><span data-i18n="trust2">Isolated Environments</span></span>
      <i class="mh-sep" aria-hidden="true"></i>
      <span class="mh-trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 3v6c0 4.5-3.2 7.6-8 9-4.8-1.4-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg><span data-i18n="trust3">Automated Backups</span></span>
      <i class="mh-sep" aria-hidden="true"></i>
      <span class="mh-trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13h4l3-7 4 14 3-7h4"/></svg><span data-i18n="trust4">Monitoring</span></span>
      <i class="mh-sep" aria-hidden="true"></i>
      <span class="mh-trust-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="3" y="12.5" width="4" height="6" rx="1.6"/><rect x="17" y="12.5" width="4" height="6" rx="1.6"/><path d="M20 18.5a3 3 0 0 1-3 3h-3"/></svg><span data-i18n="trust5">Support</span></span>
    </div></div>

    <!-- ============================================================
         3. BENTO — Everything Odoo needs
         ============================================================ -->
    <section class="mh-sec"><div class="container">
      <div class="mh-head" data-reveal="1">
        <h2 data-i18n="bento_title">Everything Odoo needs</h2>
        <p data-i18n="bento_text">A managed platform for your application, database and files — with deployment, backups and monitoring built in.</p>
      </div>
      <div class="mh-bento">
        <article class="mh-card mh-c-deploy" data-reveal="1">
          <h3 data-i18n="bento_deploy">Push to Deploy</h3>
          <p data-i18n="bento_deploy_text">Connect your repository and move approved updates through staging into production.</p>
          <div class="mh-flow" aria-hidden="true">
            <span class="mh-flow-node"><b>git push</b><small>main</small></span>
            <i class="mh-flow-link"><em></em></i>
            <span class="mh-flow-node"><b>build</b><small>dependencies</small></span>
            <i class="mh-flow-link"><em></em></i>
            <span class="mh-flow-node is-live"><b>deploy</b><small>production</small></span>
          </div>
        </article>

        <article class="mh-card mh-c-envs" data-reveal="1">
          <h3 data-i18n="bento_envs">Isolated Environments</h3>
          <p data-i18n="bento_envs_text">Separate environments for production, staging and development.</p>
          <div class="mh-env-list" aria-hidden="true">
            <span class="is-prod"><i></i>Production<small>main</small></span>
            <span class="is-stg"><i></i>Staging<small>staging</small></span>
            <span class="is-dev"><i></i>Development<small>dev</small></span>
          </div>
        </article>

        <article class="mh-card mh-c-backup" data-reveal="1">
          <h3 data-i18n="bento_backup">Automatic Backups</h3>
          <p data-i18n="bento_backup_text">Scheduled copies of your database and files.</p>
          <div class="mh-tl" aria-hidden="true">
            <span><i></i>Today · 03:00<b>✓</b></span>
            <span><i></i>Yesterday · 03:00<b>✓</b></span>
            <span class="is-muted"><i></i>Earlier<b>✓</b></span>
          </div>
        </article>

        <article class="mh-card mh-c-mon" data-reveal="1">
          <h3 data-i18n="bento_mon">Monitoring Included</h3>
          <p data-i18n="bento_mon_text">Resource usage and application health in one view.</p>
          <div class="mh-mini-chart" aria-hidden="true">
            <svg viewBox="0 0 200 60" preserveAspectRatio="none">
              <polyline class="mh-spark-line" points="0,44 25,38 50,41 75,28 100,33 125,20 150,25 175,14 200,18"/>
            </svg>
            <span class="mh-mini-legend"><i class="ok"></i>CPU<b>38%</b><i class="ok"></i>RAM<b>57%</b></span>
          </div>
        </article>

        <article class="mh-card mh-c-db" data-reveal="1">
          <h3 data-i18n="bento_db">Managed PostgreSQL</h3>
          <p data-i18n="bento_db_text">Your database runs alongside your application, included in the environment.</p>
          <div class="mh-db-row" aria-hidden="true">
            <span class="mh-db-dot"></span>
            <span class="mh-db-name">postgresql · odoo_prod</span>
            <span class="mh-db-state">connected</span>
          </div>
        </article>
      </div>
    </div></section>

    <!-- ============================================================
         4. DEPLOYMENT — full visual pipeline (dark)
         ============================================================ -->
    <section class="mh-dark"><div class="container">
      <div class="mh-head on-dark" data-reveal="1">
        <h2 data-i18n="pipe_title">From git push to production.</h2>
        <p data-i18n="pipe_text">Every change is built, tested and reviewed before your team and customers see it.</p>
      </div>

      <div class="mh-pipeline" role="img" aria-label="Deployment pipeline: git push, build, automated tests, staging, approval, production.">
        <div class="mh-pipe-line" aria-hidden="true"><i></i></div>
        <div class="mh-pipe-steps">
          <span class="mh-step"><i>1</i><b data-i18n="pipe_s1">Git Push</b><small>main</small></span>
          <span class="mh-step"><i>2</i><b data-i18n="pipe_s2">Build</b><small>dependencies</small></span>
          <span class="mh-step"><i>3</i><b data-i18n="pipe_s3">Automated Tests</b><small>checks</small></span>
          <span class="mh-step"><i>4</i><b data-i18n="pipe_s4">Staging</b><small>review</small></span>
          <span class="mh-step"><i>5</i><b data-i18n="pipe_s5">Approval</b><small>checkpoint</small></span>
          <span class="mh-step is-live"><i>6</i><b data-i18n="pipe_s6">Production</b><small>release</small></span>
        </div>
      </div>

      <div class="mh-terminal" data-reveal="1">
        <div class="mh-term-bar" aria-hidden="true"><span class="mh-dots"><i></i><i></i><i></i></span><span>deploy.log</span><span class="mh-term-state">success</span></div>
        <pre class="mh-term-body">✓ Repository synchronized
✓ Dependencies installed
✓ Database migration complete
✓ Assets compiled
✓ Production deployment successful</pre>
      </div>
    </div></section>

    <!-- ============================================================
         5. ENVIRONMENTS — product interface
         ============================================================ -->
    <section class="mh-sec"><div class="container">
      <div class="mh-head" data-reveal="1">
        <h2 data-i18n="envs_title">Every environment, one place.</h2>
        <p data-i18n="envs_text">Switch between production, staging and development, and act on each one directly.</p>
      </div>
      <div class="mh-env-ui" data-reveal="1" role="img" aria-label="Platform interface: production, staging and development environments with branch, Odoo version, workers, storage, database and last deployment, plus deploy, restart, backup and logs actions.">
        <div class="mh-env-side">
          <span class="is-active"><i class="mh-dot-prod"></i>Production</span>
          <span><i class="mh-dot-stg"></i>Staging</span>
          <span><i class="mh-dot-dev"></i>Development</span>
        </div>
        <div class="mh-env-main">
          <div class="mh-env-top">
            <b>Production</b>
            <span class="mh-badge ok"><i></i><span data-i18n="pp_running">Running</span></span>
          </div>
          <dl class="mh-env-specs">
            <div><dt data-i18n="env_branch">Branch</dt><dd>main</dd></div>
            <div><dt data-i18n="env_version">Odoo version</dt><dd>20.0</dd></div>
            <div><dt data-i18n="env_workers">Workers</dt><dd data-i18n="env_workers_v">Pay as you go</dd></div>
            <div><dt data-i18n="env_storage">Storage</dt><dd data-i18n="env_storage_v">Pay as you go</dd></div>
            <div><dt data-i18n="env_db">Database</dt><dd>PostgreSQL</dd></div>
            <div><dt data-i18n="env_last">Last deployment</dt><dd>main · successful</dd></div>
          </dl>
        </div>
        <div class="mh-env-actions">
          <button type="button" class="is-primary" data-i18n="env_act1">Deploy</button>
          <button type="button" data-i18n="env_act2">Restart</button>
          <button type="button" data-i18n="env_act3">Backup</button>
          <button type="button" data-i18n="env_act4">Logs</button>
        </div>
      </div>
    </div></section>

    <!-- ============================================================
         6. DATA & BACKUPS — split screen
         ============================================================ -->
    <section class="mh-sec mh-sec-alt"><div class="container mh-split">
      <div class="mh-data-visual" data-reveal="1" role="img" aria-label="Diagram: Odoo apps, PostgreSQL and filestore flow into an encrypted backup and then a recovery point.">
        <div class="mh-dv-sources">
          <span>Odoo Apps</span>
          <span>PostgreSQL</span>
          <span>Filestore</span>
        </div>
        <div class="mh-dv-flow" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="mh-dv-enc">🔒 <span data-i18n="data_encrypted">Encrypted Backup</span></div>
        <div class="mh-dv-line" aria-hidden="true"></div>
        <div class="mh-dv-point"><small data-i18n="data_recovery">Recovery Point</small><b>03:00</b></div>
      </div>
      <div class="mh-split-copy" data-reveal="1">
        <h2 data-i18n="data_title">Your data stays yours.</h2>
        <p data-i18n="data_text">Your application, database and files run in one environment, with backups stored according to your plan.</p>
        <ul class="mh-checks">
          <li><i>✓</i><span data-i18n="data_c1">Dedicated database and file storage</span></li>
          <li><i>✓</i><span data-i18n="data_c2">Scheduled backups with a defined recovery process</span></li>
          <li><i>✓</i><span data-i18n="data_c3">HTTPS on your own domain</span></li>
        </ul>
        <div class="mh-timeline">
          <span class="mh-tl-row"><i class="ok"></i><b data-i18n="data_t1">Today · 03:00</b><em>✓</em></span>
          <span class="mh-tl-row"><i class="ok"></i><b data-i18n="data_t2">Yesterday · 03:00</b><em>✓</em></span>
          <span class="mh-tl-row"><i class="ok"></i><b data-i18n="data_t3">Earlier copy</b><em>✓</em></span>
        </div>
      </div>
    </div></section>

    <!-- ============================================================
         7. MONITORING — observability dashboard (dark)
         ============================================================ -->
    <section class="mh-dark"><div class="container">
      <div class="mh-head on-dark" data-reveal="1">
        <h2 data-i18n="obs_title">See what your Odoo is doing.</h2>
        <p data-i18n="obs_text">CPU, memory, disk, requests and database connections — with status indicators for each environment.</p>
      </div>
      <div class="mh-obs" data-reveal="1" role="img" aria-label="Monitoring dashboard with sample data: CPU usage, memory, disk, requests, response time, database connections and uptime, all operational.">
        <div class="mh-obs-top">
          <span class="mh-obs-status"><i class="mh-pulse"></i><span data-i18n="obs_ok">All systems operational</span></span>
          <span class="mh-obs-sample" data-i18n="obs_sample">Sample data</span>
        </div>
        <div class="mh-obs-grid">
          <div class="mh-obs-tile"><small>CPU Usage</small><b>38%</b><svg viewBox="0 0 120 34" preserveAspectRatio="none" aria-hidden="true"><polyline class="mh-spark-line" points="0,26 15,20 30,23 45,15 60,19 75,11 90,15 105,8 120,12"/></svg></div>
          <div class="mh-obs-tile"><small data-i18n="obs_mem">Memory</small><b>57%</b><svg viewBox="0 0 120 34" preserveAspectRatio="none" aria-hidden="true"><polyline class="mh-spark-line" points="0,22 15,24 30,18 45,20 60,14 75,17 90,12 105,14 120,10"/></svg></div>
          <div class="mh-obs-tile"><small data-i18n="obs_disk">Disk</small><b>29%</b><svg viewBox="0 0 120 34" preserveAspectRatio="none" aria-hidden="true"><polyline class="mh-spark-line" points="0,28 15,28 30,27 45,26 60,26 75,25 90,24 105,24 120,23"/></svg></div>
          <div class="mh-obs-tile"><small data-i18n="obs_req">Requests</small><b>1.4k/h</b><svg viewBox="0 0 120 34" preserveAspectRatio="none" aria-hidden="true"><polyline class="mh-spark-line" points="0,20 15,14 30,18 45,10 60,16 75,8 90,13 105,6 120,9"/></svg></div>
          <div class="mh-obs-tile"><small data-i18n="obs_rt">Response Time</small><b>118 ms</b><svg viewBox="0 0 120 34" preserveAspectRatio="none" aria-hidden="true"><polyline class="mh-spark-line" points="0,24 15,22 30,25 45,18 60,21 75,15 90,19 105,13 120,16"/></svg></div>
          <div class="mh-obs-tile"><small data-i18n="obs_conn">DB Connections</small><b>12 / 100</b><svg viewBox="0 0 120 34" preserveAspectRatio="none" aria-hidden="true"><polyline class="mh-spark-line" points="0,27 15,25 30,26 45,22 60,24 75,20 90,22 105,18 120,20"/></svg></div>
          <div class="mh-obs-tile is-status"><small data-i18n="obs_uptime">Uptime</small><b class="ok"><i></i><span data-i18n="obs_monitored">Monitored</span></b><small class="mh-obs-note" data-i18n="obs_uptime_note">Continuous monitoring</small></div>
        </div>
      </div>
    </div></section>

    <!-- ============================================================
         8. ODOO APPS — visual ecosystem
         ============================================================ -->
    <section class="mh-sec"><div class="container">
      <div class="mh-head" data-reveal="1">
        <h2 data-i18n="eco_title">One instance. Every app.</h2>
        <p data-i18n="eco_text">Your applications run on the same environment as your data, so everything stays connected.</p>
      </div>
      <div class="mh-eco" data-reveal="1" role="img" aria-label="Diagram: sales and CRM, accounting, inventory and projects connect to your Odoo instance, which also connects to manufacturing, eCommerce, HR and custom apps.">
        <div class="mh-eco-col mh-eco-left">
          <span class="mh-eco-node"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M16 19v-1.5a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4V19"/><circle cx="9" cy="7" r="3.2"/><path d="M22 19v-1.5a4 4 0 0 0-3-3.9"/><path d="M16 4.1a4 4 0 0 1 0 7.8"/></svg><b data-i18n="eco_sales">Sales &amp; CRM</b></span>
          <span class="mh-eco-node"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20h18"/><path d="M6 20v-6"/><path d="M11 20V8"/><path d="M16 20v-9"/><path d="M21 20V5"/></svg><b data-i18n="eco_acc">Accounting</b></span>
          <span class="mh-eco-node"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8l-9-4-9 4v8l9 4 9-4z"/><path d="M3.3 7.5 12 12l8.7-4.5"/><path d="M12 12v9"/></svg><b data-i18n="eco_inv">Inventory</b></span>
          <span class="mh-eco-node"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4.5" width="17" height="15" rx="2.5"/><path d="M3.5 9.5h17"/><path d="M9.5 9.5v10"/><path d="M15 9.5v10"/></svg><b data-i18n="eco_proj">Projects</b></span>
        </div>
        <div class="mh-eco-center">
          <span class="mh-eco-hub"><i></i><b data-i18n="eco_hub">Your Odoo Instance</b><small data-i18n="eco_hub_text">Managed environment</small></span>
          <span class="mh-eco-extra" data-i18n="eco_extra">Custom Apps</span>
        </div>
        <div class="mh-eco-col mh-eco-right">
          <span class="mh-eco-node"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 20V9l7.5-4.5L19.5 9v11"/><path d="M9 20v-5h6v5"/></svg><b data-i18n="eco_mfg">Manufacturing</b></span>
          <span class="mh-eco-node"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18z"/></svg><b data-i18n="eco_ecom">eCommerce</b></span>
          <span class="mh-eco-node"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.4"/><path d="M5.5 20a6.5 6.5 0 0 1 13 0"/></svg><b data-i18n="eco_hr">HR</b></span>
          <span class="mh-eco-node"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8.5 8 5 12l3.5 4"/><path d="M15.5 8 19 12l-3.5 4"/><path d="M13.5 5.5 10.5 18.5"/></svg><b data-i18n="eco_custom">Custom Modules</b></span>
        </div>
      </div>
    </div></section>

    <!-- ============================================================
         9. COMMUNITY + ENTERPRISE
         ============================================================ -->
    <section class="mh-sec mh-sec-alt"><div class="container">
