  var navlinks = document.getElementById('mo_navlinks');
  if(menu &amp;&amp; navlinks){
    menu.addEventListener('click', function(){ navlinks.classList.toggle('open'); });
    navlinks.querySelectorAll('a').forEach(function(a){
      a.addEventListener('click', function(){ navlinks.classList.remove('open'); });
    });
  }
  var path = window.location.pathname;
  document.querySelectorAll('.mo_site .navlink').forEach(function(a){
    if(a.getAttribute('href') === path){ a.classList.add('active'); }
  });
})();
</script>

