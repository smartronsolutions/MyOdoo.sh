/* Odoo/Bootstrap compatibility and responsive safeguards. */
.mo_site{direction:ltr!important;text-align:left}
.mo_header_shell{position:sticky;top:0;z-index:1050;width:100%;overflow:visible!important}
.mo_header_shell > header{display:block!important;position:relative;top:auto;width:100%}
.mo_header_shell .nav,.mo_header_shell .nav-actions,.mo_header_shell .mo_account{overflow:visible!important}
.mo_header_shell .mo_account_drop{z-index:2000!important}
/* Keep the header on a single row for every language: Bootstrap .nav forces
   flex-wrap:wrap, which pushed the actions onto a 2nd row once translated
   labels got longer (fr/es/pt/vi). nowrap + slightly tighter spacing keeps
   the original design while fitting all languages. */
.mo_header_shell .nav{flex-wrap:nowrap!important;gap:12px!important}
.mo_header_shell .navlinks{flex-wrap:nowrap!important;min-width:0}
.mo_header_shell .navlink{padding-left:8px!important;padding-right:8px!important;white-space:nowrap}
.mo_header_shell .nav-actions{flex-wrap:nowrap!important;gap:8px!important;flex:0 0 auto}
.mo_header_shell .mo_lang_btn{padding-left:10px!important;padding-right:10px!important}
.mo_header_shell .nav-actions .btn{padding-left:13px!important;padding-right:13px!important;white-space:nowrap}
.mo_header_shell .mo_account_btn{padding-left:10px!important;padding-right:10px!important}
/* Below this width the nav links fold into the existing hamburger menu, so the
   header can never overflow, whatever the language or translation length. */
