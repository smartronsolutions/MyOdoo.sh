<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Settings → Website → SaaS Enquiry Recipient Email -->
    <record id="res_config_settings_view_form_saas_enquiry" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.website.saas.enquiry</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="website_settings" position="inside">
                <setting id="saas_enquiry_recipient_setting"
                         string="SaaS Enquiry Notifications"
                         help="Emails sent for every enquiry submitted from the website form. The sender address is bound to the default outgoing mail server.">
                    <field name="saas_enquiry_recipient_email"
                           placeholder="e.g. notifications@myodoo.sh"/>
                    <field name="saas_enquiry_from_email"
                           placeholder="e.g. notifications@myodoo.sh"/>
                </setting>
            </block>
        </field>
    </record>

</odoo>
