         7. CONNECTION SETUP — endpoint + tools
         ============================================================ -->
    <section id="setup" class="mh-sec"><div class="container">
      <div class="mh-head" data-reveal="1">
        <h2 data-i18n="mcp_setup_title">Connection setup</h2>
        <p data-i18n="mcp_setup_text">Get your MCP SSE endpoint and connect AI to Odoo in minutes.</p>
      </div>
      <div class="mcp-setup">
        <div class="mcp-panel" data-reveal="1">
          <span class="mh-badge" data-i18n="mcp_setup_badge">MCP SSE endpoint</span>
          <h3 class="mcp-panel-title" data-i18n="mcp_setup_endpoint_title">Your secure endpoint</h3>
          <div class="mcp-endpoint">
            <code><t t-out="'https://mcpodoo.com/sse'"/></code>
            <button type="button" class="mcp-copy" data-mcp-copy="https://mcpodoo.com/sse" data-i18n="mcp_setup_copy">Copy endpoint</button>
          </div>
          <ol class="mcp-steps">
            <li data-i18n="mcp_setup_s1">Open your AI client settings and add a connector.</li>
            <li data-i18n="mcp_setup_s2">Paste the SSE endpoint URL above.</li>
            <li data-i18n="mcp_setup_s3">Done — the Odoo tools appear immediately.</li>
          </ol>
        </div>
        <div class="mcp-panel" data-reveal="1">
          <span class="mh-badge" data-i18n="mcp_tools_badge">Available tools</span>
          <h3 class="mcp-panel-title" data-i18n="mcp_tools_title">What your assistant can do</h3>
          <ul class="feat-list">
            <li><b><t t-out="'odoo_server_info'"/></b><small data-i18n="mcp_tool1">Get server information and status</small></li>
            <li><b><t t-out="'odoo_list_models'"/></b><small data-i18n="mcp_tool2">List all available Odoo models</small></li>
            <li><b><t t-out="'odoo_search_records'"/></b><small data-i18n="mcp_tool3">Search and retrieve records</small></li>
            <li><b><t t-out="'odoo_create_record'"/></b><small data-i18n="mcp_tool4">Create new records in Odoo</small></li>
            <li><b><t t-out="'odoo_update_record'"/></b><small data-i18n="mcp_tool5">Update existing records</small></li>
            <li><b><t t-out="'odoo_execute_method'"/></b><small data-i18n="mcp_tool6">Execute custom Odoo methods</small></li>
          </ul>
        </div>
      </div>
    </div></section>

