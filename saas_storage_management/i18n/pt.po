#. module: saas_storage_management
#: model:mail.template,body_html:saas_storage_management.storage_upgrade_approved_mail_template
msgid ""
"<div>\n"
"                <div style=\"text-align:center; font-size:18px; color:#5cb85c;\"><strong>STORAGE UPGRADE APPROVED</strong></div>\n"
"                <hr width=\"100%\" style=\"background-color:#5cb85c; border:none; height:3px; margin: 16px 0px 16px 0px;\"/>\n"
"            </div>\n"
"            <div>\n"
"                <div>Dear <span t-out=\"object.partner_id.name or ''\"/>,</div>\n"
"                <br/>\n"
"                <div>\n"
"                    Your storage upgrade request for instance <strong><span t-out=\"object.name or ''\"/></strong> has been approved.\n"
"                    Your new storage limit is <strong style=\"color:#5cb85c;\"><span t-out=\"object.storage_limit_gb\"/> GB</strong>.\n"
"                </div>\n"
"                <br/>\n"
"                <div>If your instance was stopped due to full storage, please contact support to have it restarted, or check your <a href=\"/my/storage\">Storage Dashboard</a>.</div>\n"
"            </div>\n"
"            <br/>\n"
"            <div>\n"
"                <div>Thank you for using our services. If you have any questions, please contact our support team.</div>\n"
"            </div>\n"
"        "
msgstr ""

#. module: saas_storage_management
#: model:mail.template,body_html:saas_storage_management.storage_full_mail_template
msgid ""
"<div>\n"
"                <div style=\"text-align:center; font-size:18px; color:#d9534f;\"><strong>STORAGE FULL - INSTANCE STOPPED</strong></div>\n"
"                <hr width=\"100%\" style=\"background-color:#d9534f; border:none; height:3px; margin: 16px 0px 16px 0px;\"/>\n"
"            </div>\n"
"            <div>\n"
"                <div>Dear <span t-out=\"object.partner_id.name or ''\"/>,</div>\n"
"                <br/>\n"
"                <div>\n"
"                    Your Odoo instance <strong><span t-out=\"object.name or ''\"/></strong> has reached\n"
"                    <strong style=\"color:#d9534f;\">100%</strong> of its storage limit\n"
"                    (<strong><span t-out=\"object.storage_limit_gb\"/> GB</strong>).\n"
"                </div>\n"
"                <br/>\n"
"                <div>To protect your data, your instance has been <strong>automatically stopped</strong> and is no longer accessible.</div>\n"
"                <br/>\n"
"                <div>\n"
"                    Please contact our support team to increase your storage limit so your instance can be resumed,\n"
"                    or request an upgrade from your <a href=\"/my/storage\">Storage Dashboard</a>.\n"
"                </div>\n"
"            </div>\n"
"            <br/>\n"
"            <div>\n"
"                <div>We're sorry for the inconvenience. Our support team is ready to help you get back online.</div>\n"
"            </div>\n"
"        "
msgstr ""

#. module: saas_storage_management
#: model:mail.template,body_html:saas_storage_management.storage_warning_mail_template
msgid ""
"<div>\n"
"                <div style=\"text-align:center; font-size:18px; color:#fcb042;\"><strong>STORAGE WARNING</strong></div>\n"
"                <hr width=\"100%\" style=\"background-color:#fcb042; border:none; height:3px; margin: 16px 0px 16px 0px;\"/>\n"
"            </div>\n"
"            <div>\n"
"                <div>Dear <span t-out=\"object.partner_id.name or ''\"/>,</div>\n"
"                <br/>\n"
"                <div>\n"
"                    Your Odoo instance <strong><span t-out=\"object.name or ''\"/></strong> has used\n"
"                    <strong><span t-out=\"'%.2f' % object.storage_used_gb\"/> GB</strong> out of\n"
"                    <strong><span t-out=\"object.storage_limit_gb\"/> GB</strong>\n"
"                    (<strong style=\"color:#fcb042;\"><span t-out=\"'%.1f' % object.storage_percentage\"/>%</strong>).\n"
"                </div>\n"
"                <br/>\n"
"                <div>Once your storage reaches 100%, your instance will be automatically stopped until more storage is made available.</div>\n"
"                <br/>\n"
"                <div>\n"
"                    You can request a storage upgrade from your\n"
"                    <a href=\"/my/storage\">Storage Dashboard</a>.\n"
"                </div>\n"
"            </div>\n"
"            <br/>\n"
"            <div>\n"
"                <div>If you have any questions or need help, please contact our support team.</div>\n"
"            </div>\n"
"        "
msgstr ""

