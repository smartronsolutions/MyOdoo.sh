<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="saas_instance_tag_view_tree" model="ir.ui.view">
        <field name="name">saas.instance.tag.view.tree</field>
        <field name="model">saas.instance.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </list>
        </field>
    </record>

    <record id="saas_instance_tag_view_form" model="ir.ui.view">
        <field name="name">saas.instance.tag.view.form</field>
        <field name="model">saas.instance.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="saas_instance_tag_action" model="ir.actions.act_window">
        <field name="name">Instance Tags</field>
        <field name="res_model">saas.instance.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="saas_instance_tag_menu" name="Instance Tags"
        parent="saas_menu_odoo_instance" sequence="99"
        action="saas_instance_tag_action"/>
</odoo>
