<?xml version="1.0" encoding="UTF-8"?>
<odoo>

	<record id="saas_odoo_instance_port_view_tree" model="ir.ui.view">
        <field name="name">saas.odoo.instance.port.view.tree</field>
        <field name="model">saas.odoo.instance.port</field>
        <field name="arch" type="xml">
            <list string="SaaS Odoo Instance Port">
                <field name="name"/>
                <field name="port"/>
                <field name="pserver_id"/>
                <field name="instance_id"/>
                <field name="based_domain_id"/>
            </list>
        </field>
    </record>
    
    <record id="saas_odoo_instance_port_view_search" model="ir.ui.view">
        <field name="name">saas.odoo.instance.port.view.search</field>
        <field name="model">saas.odoo.instance.port</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="port"/>
                <field name="instance_id"/>
                <field name="pserver_id"/>
                <field name="based_domain_id"/>
                <separator/>
                <filter name="ftr_used" string="Used" domain="[('instance_id', '!=', False)]"/>
                <filter name="ftr_not_used" string="Not used" domain="[('instance_id', '=', False)]"/>
                <group expand="1" string="Group By">
                    <filter name="grb_instance" string="Odoo Instance" context="{'group_by':'instance_id'}"/>
                    <filter name="grb_pserver" string="Physical Server" context="{'group_by':'pserver_id'}"/>
                    <filter name="grb_based_domain" string="Based Domain" context="{'group_by':'based_domain_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <record id="saas_odoo_instance_port_action" model="ir.actions.act_window">
        <field name="name">Odoo Instance Ports</field>
        <field name="res_model">saas.odoo.instance.port</field>
        <field name="context">{'search_default_grb_instance': 1}</field>
        <field name="view_mode">list</field>
    </record>
    
    <menuitem id="saas_odoo_instance_port" action="saas_odoo_instance_port_action" parent="saas_menu_odoo_instance" sequence="20"/>

</odoo>
