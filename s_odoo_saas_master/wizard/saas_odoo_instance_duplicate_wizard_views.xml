<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="saas_odoo_instance_duplicate_wizard_view_form" model="ir.ui.view">
        <field name="name">saas.odoo.instance.duplicate.wizard.view.form</field>
        <field name="model">saas.odoo.instance.duplicate.wizard</field>
        <field name="arch" type="xml">
            <form string="Duplicate Instance">
                <group>
                    <group>
                        <field name="instance_id" invisible="1"/>
                        <field name="current_subdomain"/>
                        <field name="based_domain_id"/>
                        <field name="new_subdomain"
                               placeholder="e.g. my-instance-copy"/>
                    </group>
                </group>
                <footer>
                    <button string="Duplicate" type="object"
                            name="action_duplicate" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="saas_odoo_instance_duplicate_wizard_action" model="ir.actions.act_window">
        <field name="name">Duplicate Instance</field>
        <field name="res_model">saas.odoo.instance.duplicate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{"default_new_subdomain": context.get("default_new_subdomain")}</field>
    </record>
</odoo>
