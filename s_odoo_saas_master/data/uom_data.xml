<?xml version="1.0" encoding="UTF-8"?>
<odoo noupdate="1">

	<record id="product_uom_categ_saas_user" model="uom.category">
        <field name="name">Workers</field>
    </record>
    
    <record id="product_uom_saas_user_month" model="uom.uom">
        <field name="category_id" ref="product_uom_categ_saas_user"/>
        <field name="name">Worker</field>
        <field name="factor" eval="1.0"/>
        <field name="uom_type">reference</field>
    </record>
    
    <record id="product_uom_categ_saas_app" model="uom.category">
        <field name="name">SaaS App</field>
    </record>
    
    <record id="product_uom_saas_app_month" model="uom.uom">
        <field name="category_id" ref="product_uom_categ_saas_app"/>
        <field name="name">App</field>
        <field name="factor" eval="1.0"/>
        <field name="uom_type">reference</field>
    </record>

</odoo>
